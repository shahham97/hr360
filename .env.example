# Server & App Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Master Master Key (32 bytes hex = 64 chars)
# Used for AES-256-GCM envelope encryption of tenant DB passwords and sensitive fields
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Master Database (TiDB Cloud or local MySQL for development/spike)
# Standard TiDB Cloud connection string:
DATABASE_URL="mysql://root:password@127.0.0.1:4000/hr360_master?sslaccept=strict"

# Admin / Super Admin Provisioning Root
SUPER_ADMIN_EMAIL=superadmin@hr360.local
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstBoot_HR360_2026!

# JWT & Session Secret
JWT_SECRET=supersecret-hr360-jwt-signing-key-minimum-32-chars-long
REFRESH_TOKEN_SECRET=supersecret-hr360-refresh-token-signing-key-32-chars

# TiDB Serverless Spike Parameters (optional TiDB Cloud HTTP endpoint)
TIDB_CLOUD_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_CLOUD_PORT=4000
TIDB_CLOUD_USER=
TIDB_CLOUD_PASSWORD=
